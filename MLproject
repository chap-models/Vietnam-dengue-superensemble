name: Vietnam_dengue_superensemble

target: disease_cases

required_covariates:
  - population
  - minimum_temperature
  - maximum_temperature
  - nino34_anomaly
  - specific_surface_humidity
  - wind_speed
  - periurban_landcover
  - urban_landcover

supported_period_type: month
max_prediction_length: 1

meta_data:
  display_name: Vietnam Dengue Superensemble
  description: >
    Bayesian model averaging (BMA) of five INLA models for dengue forecasting in Vietnam, note that it may be a less good candiadate model in other countries.
    Each candidate model includes a BYM spatial random effect, an IID year-by-province
    random effect, and an AR1 month-by-province random effect. Models differ in which
    climate and land-cover covariates are included. BMA weights combine marginal
    likelihoods and DIC. Based on Colón-González et al. (2021), PLoS Medicine.
  author: Halvard Emil Sand-Larsen
  author_assessed_status: red
  organization: HISP Centre, University of Oslo
  organization_logo_url: https://landportal.org/sites/default/files/2024-03/university_of_oslo_logo.png
  contact_email: halvares@uio.no
  citation_info: >
    Colón-González FJ, et al. (2021). Probabilistic seasonal dengue forecasting in Vietnam:
    A modelling study using superensembles. PLOS Medicine.
    https://doi.org/10.1371/journal.pmed.1003542.
    Original model developed at the London School of Hygiene & Tropical Medicine
    (Centre for the Mathematical Modelling of Infectious Diseases; Department of
    Infectious Disease Epidemiology; Centre on Climate Change and Planetary Health)
    and the Tyndall Centre for Climate Change Research, University of East Anglia.

adapters:
  disease_cases: disease_cases
  Cases: disease_cases
  E: population
  areaid: location
  month: month
  ID_year: year

docker_env:
  image: ghcr.io/dhis2-chap/docker_r_inla:master

entry_points:
  train:
    parameters:
      train_data: path
      model: str
      geojson: path
    command: "Rscript train.R {train_data} {model} {polygons}"
  predict:
    parameters:
      historic_data: path
      future_data: path
      model: str
      out_file: path
      geojson: path
    command: "Rscript predict.R {model} {historic_data} {future_data} {out_file} {polygons}"
